{
  "name": "komapal-shogi",
  "version": "0.1.0",
  "private": true,
  "description": "KomaPal Shogi — 子ども向け CPU 対戦将棋（ブラウザだけで動く）",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node tools/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node tools/copy-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node tools/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "selfplay": "tsx tests/selfplay.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mizarjp/yaneuraou.material9": "7.6.3-alpha.0",
    "shogiops": "^0.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "coi-serviceworker": "^0.1.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
